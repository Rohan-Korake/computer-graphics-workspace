{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build Graphics C++",
      "command": "clang++",
      "args": [
        "-std=c++17",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}",
        "-framework",
        "OpenGL",
        "-framework",
        "GLUT",
        "-DGL_SILENCE_DEPRECATION"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
